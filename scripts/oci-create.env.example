# Copy this file to ~/.oci-instance-creator.env and replace the values.

COMPARTMENT_ID="ocid1.tenancy.oc1..replace-me"
AVAILABILITY_DOMAIN="qibq:AP-CHUNCHEON-1-AD-1"
AVAILABILITY_DOMAIN_NUMBER="1"
SUBNET_ID="ocid1.subnet.oc1..replace-me"
SUBNET_NAME=""
IMAGE_ID="ocid1.image.oc1..replace-me"
IMAGE_OPERATING_SYSTEM="Canonical Ubuntu"
IMAGE_OPERATING_SYSTEM_VERSION="24.04 Minimal aarch64"
INSTANCE_NAME="oci-free-tier-a1"
INSTANCE_NAME_PREFIX="oci-free-tier-a1"
TARGET_INSTANCE_COUNT="1"
SSH_KEY_FILE="$HOME/.ssh/oci_key.pub"
# Or set SSH_PUBLIC_KEY directly and leave SSH_KEY_FILE unused.
SSH_PUBLIC_KEY=""

# Optional
DISCORD_WEBHOOK=""
OCI_CLI_BIN=""
OCI_CONFIG_FILE=""
OCI_PROFILE="DEFAULT"
OCI_CONNECTION_TIMEOUT_SECONDS="120"
OCI_READ_TIMEOUT_SECONDS="240"
DEFAULT_REGION="ap-chuncheon-1"
REGION_ROTATION=""
LOG_FILE="$HOME/oci-instance.log"
SUCCESS_FLAG="$HOME/.oci-instance-created"
VALIDATE_ONLY="0"
OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING="True"
OCI_SHAPE="VM.Standard.A1.Flex"
OCPUS="4"
MEMORY_GB="24"
BOOT_VOLUME_GB="100"
UPGRADE_AFTER_CREATE="false"
UPGRADE_STEPS=""
UPGRADE_OCPUS="4"
UPGRADE_MEMORY_GB="24"
ASSIGN_PUBLIC_IP="true"
INTERVAL_SECONDS="60"
RATE_LIMIT_BACKOFF_SECONDS="120"
JITTER_SECONDS="10"
THROTTLE_STATE_FILE="$HOME/.oci-instance-throttle.json"
MIN_INTERVAL_SECONDS="85"
MAX_INTERVAL_SECONDS="360"
RATE_LIMIT_MULTIPLIER="1.15"
DECAY_AFTER_NON_429="3"
DECAY_SECONDS="15"
PROACTIVE_COOLDOWN_AFTER_MIN_ATTEMPTS="25"
PROACTIVE_COOLDOWN_INTERVAL_SECONDS="120"
EXISTING_CHECK_EVERY_ATTEMPTS="0"
MAX_ATTEMPTS="0"
